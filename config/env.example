# Copy to config/.env and fill in. canarchist reads it itself; shell values win at initial load, but later
# file edits can replace them. Restart after model/connector credential changes to update existing agents
# reliably. The installer sources this file for its check: keep values shell-safe. See SETUP.md section 0.
# Never commit the filled-in file.

CA_OPERATOR=jdoe
CA_MODEL=                    # optional: the lead's model profile; default is default_model in config/models.yaml
CA_ROE=                      # e.g. roe.local.yaml: your site's scope, kept out of git (SETUP.md section 9)

# --- models (profiles live in config/models.yaml; these fill in its ${VARIABLES}) -------------------
# GenAI: government / enterprise gateway (OpenAI-compatible)
GENAI_BASE_URL=https://CHANGE-ME/v1
GENAI_MODEL=CHANGE-ME
GENAI_API_KEY=
GENAI_API_KEY_HEADER=Authorization
DOD_CA_BUNDLE=/etc/pki/dod/dod_roots.pem
GENAI_CLIENT_CERT=
GENAI_CLIENT_KEY=
# Claude (Anthropic API)
ANTHROPIC_API_KEY=
# ChatGPT (OpenAI API); the model ids are optional overrides
OPENAI_API_KEY=
OPENAI_MODEL=                # default gpt-5.6-sol
OPENAI_MODEL_SMALL=          # default gpt-5.6-luna
# Local servers
OLLAMA_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:32b
VLLM_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=Qwen/Qwen3-32B
VLLM_API_KEY=
LLAMACPP_URL=http://127.0.0.1:8080/v1
MY_LLM_API_KEY=              # only if the server in the my-local-model template needs a key

# --- Security Onion 3 (direct Elasticsearch; topology/firewall/key steps in SETUP.md section 2) ---
# Use the standalone, managersearch, or distributed manager endpoint. Remote direct access needs TCP 9200;
# use the destination node's firewall.hostgroups.elasticsearch_rest override if not already allowed.
# Prefer a scoped key granting "read" on logs-*-so. Store only the response's encoded value (no ApiKey prefix).
# Without view_index_metadata, list_data_streams uses a read-only fallback.
SO_ENABLED=false
SO_URL=https://so-manager:9200
SO_API_KEY=
SO_USER=                       # or a local SOC account with ES read access; leave SO_API_KEY empty
SO_PASS=
SO_VERIFY=/etc/pki/so/ca.crt   # path on this host; default grid CA is /etc/pki/ca.crt on the manager/single node
SO_INDEX=logs-*-so
SO_ALERT_INDEX=logs-*.alerts-so   # Suricata + SO Detections alert streams
SO_ZEEK_INDEX=logs-zeek-so

# --- Splunk (management port) -------------------------------------------------
SPLUNK_ENABLED=false
SPLUNK_URL=https://splunk:8089
SPLUNK_TOKEN=
SPLUNK_VERIFY=true
SPLUNK_EXTRA_COMMANDS=          # read-only SPL commands beyond the built-in list, e.g. ldapsearch (comma list)
SPLUNK_ALLOW_MACROS=            # macros agents may use, e.g. sysmon,cim_Authentication_indexes (or * for all)

# --- Elastic ------------------------------------------------------------------
# Use the actual Elasticsearch endpoint (Cloud/proxies may use HTTPS 443); see SETUP.md section 3.
# ES_API_KEY is only the encoded Elasticsearch API key, without the ApiKey header prefix.
ES_ENABLED=false
ES_URL=https://elastic:9200
ES_API_KEY=
ES_VERIFY=true
ES_DEFAULT_INDEX=logs-*

# --- Velociraptor (api client config from `velociraptor config api_client`) ---
VELO_ENABLED=false
VELO_API_CONFIG=/path/to/compensatedanarchist/config/secrets/canarchist.api.yaml        # role investigator,api
VELO_ADMIN_ENABLED=false
VELO_ADMIN_API_CONFIG=/path/to/compensatedanarchist/config/secrets/canarchist_admin.api.yaml  # role administrator,api
VELO_ORG_ID=
VELO_DOWNLOAD_DIR=

# --- threat intel ----------------------------------------------------------------
MISP_ENABLED=false
MISP_URL=https://misp.example
MISP_KEY=
MISP_VERIFY=true
OPENCTI_ENABLED=false
OPENCTI_URL=https://opencti.example
OPENCTI_TOKEN=
OPENCTI_VERIFY=true

# --- Archer (beacon / exfil / lateral movement findings from Zeek; read-only) ------------
ARCHER_ENABLED=false
ARCHER_URL=https://localhost:8443
ARCHER_EMAIL=                  # a Viewer account's email (login uses the email, not the display name)
ARCHER_PASSWORD=
ARCHER_TLS_FINGERPRINT=        # SHA-256 of Archer's certificate (Archer shows it at GET /api/sensors/info)
ARCHER_VERIFY=true             # only used without a fingerprint: true | /path/ca.pem | false (no check)

# --- local forensics ----------------------------------------------------------
YARA_RULES=/opt/rules/yara
SIGMA_RULES=/opt/rules/sigma
CAPA_RULES=/opt/rules/capa-rules
EZ_TOOLS_DIR=/opt/zimmermantools
MEMPROCFS_PYTHON=
ALEAPP_PATH=/opt/ALEAPP/aleapp.py
ILEAPP_PATH=/opt/iLEAPP/ileapp.py
LEAPP_PYTHON=
