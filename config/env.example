# Copy to config/.env, fill in, then: set -a; source config/.env; set +a
# Never commit the filled-in file.

CA_OPERATOR=jdoe
CA_DASHBOARD_TOKEN=          # optional fixed dashboard token (default: random per start)
CA_MODEL=local-vllm

# --- models -------------------------------------------------------------------
VLLM_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=Qwen/Qwen3-32B
OLLAMA_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:32b
GENAI_BASE_URL=https://CHANGE-ME/v1
GENAI_MODEL=CHANGE-ME
GENAI_API_KEY=
GENAI_API_KEY_HEADER=Authorization
DOD_CA_BUNDLE=/etc/pki/dod/dod_roots.pem
GENAI_CLIENT_CERT=
GENAI_CLIENT_KEY=
ANTHROPIC_API_KEY=

# --- Security Onion 3 (ES on the manager :9200; add a 9200 port group + host group for this host) ---
# Prefer a read-only API key (Kibana Dev Tools: POST /_security/api_key with a role descriptor granting only
# index privilege "read" on logs-*). Without view_index_metadata, list_data_streams uses a read-only fallback.
SO_ENABLED=false
SO_URL=https://so-manager:9200
SO_API_KEY=
SO_USER=                       # or a SOC account instead of an API key
SO_PASS=
SO_VERIFY=/etc/pki/so/ca.crt   # copy of /etc/pki/ca.crt from the SO3 manager
SO_INDEX=logs-*-so
SO_ALERT_INDEX=logs-*.alerts-so   # Suricata + SO Detections alert streams
SO_ZEEK_INDEX=logs-zeek-so

# --- Splunk (management port) -------------------------------------------------
SPLUNK_ENABLED=false
SPLUNK_URL=https://splunk:8089
SPLUNK_TOKEN=
SPLUNK_VERIFY=true

# --- Elastic ------------------------------------------------------------------
ES_ENABLED=false
ES_URL=https://elastic:9200
ES_API_KEY=
ES_VERIFY=true
ES_DEFAULT_INDEX=logs-*

# --- Velociraptor (api client config from `velociraptor config api_client`) ---
VELO_ENABLED=false
VELO_API_CONFIG=/etc/canarchist/velo_investigator.api.yaml      # role investigator,api
VELO_ADMIN_ENABLED=false
VELO_ADMIN_API_CONFIG=/etc/canarchist/velo_admin.api.yaml       # role administrator,api
VELO_ORG_ID=
VELO_DOWNLOAD_DIR=

# --- threat intel ----------------------------------------------------------------
MISP_ENABLED=false
MISP_URL=https://misp.example
MISP_KEY=
MISP_VERIFY=true
OPENCTI_ENABLED=false
OPENCTI_URL=https://opencti.example
OPENCTI_TOKEN=
OPENCTI_VERIFY=true

# --- local forensics ----------------------------------------------------------
YARA_RULES=/opt/rules/yara
SIGMA_RULES=/opt/rules/sigma
CAPA_RULES=/opt/rules/capa-rules
EZ_TOOLS_DIR=/opt/zimmermantools
MEMPROCFS_PYTHON=
ALEAPP_PATH=/opt/ALEAPP/aleapp.py
ILEAPP_PATH=/opt/iLEAPP/ileapp.py
LEAPP_PYTHON=
